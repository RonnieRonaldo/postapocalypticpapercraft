{
  "name": "postapocalypticpapercraft",
  "compatibility_date": "2026-10-25",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/downloads"]
  },
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "post-apo-papercraft-downloads" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "post-apo-orders", "database_id": "fb9f8e85-7643-4ed7-8567-aaf56288ab4b" }
  ]
}
